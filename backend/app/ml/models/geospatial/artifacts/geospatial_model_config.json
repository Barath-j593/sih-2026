{
  "model_name": "geospatial_isolation_forest",
  "model_version": "1.0.0",
  "mode": "early_warning",
  "random_state": 42,
  "n_estimators": 200,
  "contamination": 0.05,
  "max_samples": "auto",
  "bootstrap": false,
  "earth_radius_km": 6371.0088,
  "dbscan_eps_km": 25.0,
  "dbscan_min_samples": 5,
  "lof_n_neighbors": 15,
  "local_density_radius_km": 25.0,
  "k_nearest_neighbors": 5,
  "primary_cluster_column": "geo__geographic_cluster_id",
  "peer_work_type_column": "project__work_type",
  "peer_category_column": "project__category",
  "peer_mad_multiplier": 1.4826,
  "peer_epsilon": 1e-06,
  "anomaly_percentile_cutoff": 95.0,
  "base_spatial_features_count": 10,
  "retrospective_features_count": 5,
  "quarantined_labels_count": 9,
  "master_features_path": "backend/app/ml/data/processed/project_master_features.csv",
  "labels_path": "backend/app/ml/data/processed/project_labels.csv",
  "output_scores_path": "backend/app/ml/data/processed/geospatial_anomaly_scores.csv",
  "artifacts_dir": "backend/app/ml/models/geospatial/artifacts",
  "report_json_path": "backend/app/ml/reports/geospatial_model_report.json",
  "report_md_path": "backend/app/ml/reports/GEOSPATIAL_MODEL_REPORT.md"
}