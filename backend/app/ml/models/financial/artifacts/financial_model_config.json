{
  "model_name": "financial_isolation_forest",
  "model_version": "1.0.0",
  "mode": "early_warning",
  "random_state": 42,
  "n_estimators": 200,
  "contamination": 0.05,
  "max_samples": "auto",
  "bootstrap": false,
  "primary_peer_column": "project__work_type",
  "secondary_peer_column": "project__category",
  "peer_mad_multiplier": 1.4826,
  "peer_epsilon": 1e-06,
  "anomaly_percentile_cutoff": 95.0,
  "base_financial_features_count": 50,
  "retrospective_features_count": 5,
  "quarantined_labels_count": 9,
  "master_features_path": "backend/app/ml/data/processed/project_master_features.csv",
  "labels_path": "backend/app/ml/data/processed/project_labels.csv",
  "output_scores_path": "backend/app/ml/data/processed/financial_anomaly_scores.csv",
  "artifacts_dir": "backend/app/ml/models/financial/artifacts",
  "report_json_path": "backend/app/ml/reports/financial_model_report.json",
  "report_md_path": "backend/app/ml/reports/FINANCIAL_MODEL_REPORT.md"
}