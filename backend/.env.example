# ===================================================
# SETU Backend Environment Configuration
# ===================================================

# Application
PROJECT_NAME="SETU — AI-Powered MPLADS Anomaly, Fraud & Inefficiency Detection"
VERSION="1.0.0"
API_V1_STR="/api"

# Security & JWT (Generate a secure key in production using `openssl rand -hex 32`)
SECRET_KEY="replace_with_a_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (SQLite by default, or PostgreSQL)
# SQLite default: sqlite:///./setu_mplads.db
# PostgreSQL example: postgresql://user:password@localhost:5432/setu_mplads
DATABASE_URL="sqlite:///./setu_mplads.db"

# Allowed CORS Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
